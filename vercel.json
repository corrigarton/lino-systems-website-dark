{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/course",
      "destination": "https://fit-align-preface.vercel.app"
    },
    {
      "source": "/course/:path*",
      "destination": "https://fit-align-preface.vercel.app/:path*"
    },
	{
      "source": "/fitalign",
      "destination": "https://landing-page-hyya.vercel.app/"
    },
    {
      "source": "/fitalign/:path*",
      "destination": "https://landing-page-hyya.vercel.app/:path*"
    }
  ]
}